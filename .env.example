# Copy this file to .env and adjust for your environment before deployment.

# Frontend runtime configuration
VITE_OPENAI_API_KEY=
VITE_OPENAI_API_ENDPOINT=
VITE_LLM_MODEL_NAME=
VITE_API_BASE_URL=
VITE_HIDE_SCHEMADASH_CLOUD=true
VITE_DISABLE_ANALYTICS=true

# Local development proxy target for `npm run dev:web`
SCHEMADASH_API_PROXY=http://localhost:4010

# Docker Compose exposed ports
SCHEMADASH_WEB_PORT=8080
SCHEMADASH_API_PORT=4010
SCHEMADASH_POSTGRES_PORT=5432

# PostgreSQL container settings for the local stack
SCHEMADASH_POSTGRES_DB=schemadash
SCHEMADASH_POSTGRES_USER=schemadash
SCHEMADASH_POSTGRES_PASSWORD=replace-with-a-local-dev-password

# Backend runtime settings
SCHEMADASH_API_HOST=0.0.0.0
SCHEMADASH_CORS_ORIGIN=http://localhost:8080
SCHEMADASH_TRUST_PROXY=false
SCHEMADASH_SECRET_KEY=replace-with-a-long-random-secret
SCHEMADASH_DATA_DIR=.schemadash-data
SCHEMADASH_APP_DB_PATH=
SCHEMADASH_METADATA_DB_PATH=
SCHEMADASH_LOG_LEVEL=info
SCHEMADASH_AUTH_MODE=disabled
SCHEMADASH_AUTH_EMAIL=
SCHEMADASH_AUTH_PASSWORD=
SCHEMADASH_AUTH_DISPLAY_NAME=SchemaDash Owner
SCHEMADASH_BOOTSTRAP_SETUP_CODE=
SCHEMADASH_BOOTSTRAP_SETUP_CODE_TTL_MS=900000
SCHEMADASH_BOOTSTRAP_SETUP_CODE_MAX_ATTEMPTS=10
SCHEMADASH_BOOTSTRAP_ADMIN_EMAIL=
SCHEMADASH_SESSION_TTL_HOURS=168
SCHEMADASH_SESSION_COOKIE_NAME=schemadash_session
SCHEMADASH_SESSION_COOKIE_SECURE=
SCHEMADASH_OIDC_ISSUER=
SCHEMADASH_OIDC_CLIENT_ID=
SCHEMADASH_OIDC_CLIENT_SECRET=
SCHEMADASH_OIDC_REDIRECT_URL=
SCHEMADASH_OIDC_LOGOUT_URL=
SCHEMADASH_OIDC_SCOPES=openid profile email
SCHEMADASH_DEFAULT_PROJECT_NAME=My Diagrams
SCHEMADASH_DEFAULT_OWNER_NAME=Local Owner

# Main app schema sync integration
# Set enabled=true only when the standalone schema sync service is running.
# For Docker Compose, start with `COMPOSE_PROFILES=schema-sync` and keep the
# service URL on the internal container hostname below.
# For local non-container backend runs, change the URL to http://localhost:4020.
SCHEMADASH_SCHEMA_SYNC_ENABLED=false
SCHEMADASH_SCHEMA_SYNC_SERVICE_URL=http://schema-sync-adapter:4020

# Standalone schema sync service runtime settings
# Keep these here so the root file remains the complete environment reference
# for the full local stack.
SCHEMADASH_SCHEMA_SYNC_SERVICE_HOST=0.0.0.0
SCHEMADASH_SCHEMA_SYNC_SERVICE_PORT=4020
SCHEMADASH_SCHEMA_SYNC_SERVICE_DATA_DIR=.schemadash-schema-sync-service
SCHEMADASH_SCHEMA_SYNC_METADATA_DB_PATH=
SCHEMADASH_SCHEMA_SYNC_SECRET_KEY=change-me-before-production
SCHEMADASH_SCHEMA_SYNC_LOG_LEVEL=info
